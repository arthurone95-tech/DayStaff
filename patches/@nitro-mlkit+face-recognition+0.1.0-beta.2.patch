+      largest.headEulerAngleY.toDouble(),
+      largest.headEulerAngleX.toDouble(),
+      largest.headEulerAngleZ.toDouble(),
+      (largest.leftEyeOpenProbability ?: -1f).toDouble(),
+      (largest.rightEyeOpenProbability ?: -1f).toDouble(),
+      largest.boundingBox.width().toDouble() / bitmap.width.toDouble(),
+    )
+    return Pair(embedding, pose)
+  }

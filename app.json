{
  "expo": {
    "name": "DayStaff",
    "slug": "daystaff",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "daystaff",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#061734",
      "imageWidth": 200
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.daystaff.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "DayStaff uses Face ID to verify staff attendance.",
        "NSLocalNetworkUsageDescription": "DayStaff uses the local network to connect staff phones to this kiosk for offline attendance.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.daystaff.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DayStaff to use the front camera for face check-in.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow DayStaff to use Face ID for staff attendance verification."
        }
      ],
      "@nitro-mlkit/face-recognition",
      "./src/plugins/withNitroProguardKeepRules.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DayStaff to choose staff profile photos.",
          "cameraPermission": "Allow DayStaff to take staff profile photos.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      "./src/plugins/withKioskLockTask.js",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#061734",
          "android": {
            "imageWidth": 200
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a5cb42f2-3bcb-4f99-9ab0-923046218c34"
      }
    },
    "owner": "nana-arthur"
  }
}

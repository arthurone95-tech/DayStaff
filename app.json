{
  "expo": {
    "name": "DayStaff",
    "slug": "daystaff",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "daystaff",
    "splash": {
      "image": "./assets/splash-content.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B132B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.daystaff.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "DayStaff uses Face ID to verify staff attendance.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.daystaff.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DayStaff to use the front camera for face check-in.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow DayStaff to use Face ID for staff attendance verification."
        }
      ],
      "@nitro-mlkit/face-recognition",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DayStaff to choose staff profile photos.",
          "cameraPermission": "Allow DayStaff to take staff profile photos.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      "./src/plugins/withKioskLockTask.js"
    ],
    "extra": {
      "eas": {
        "projectId": "a5cb42f2-3bcb-4f99-9ab0-923046218c34"
      }
    },
    "owner": "nana-arthur"
  }
}
